# syntax=docker/dockerfile:1
# Build context: root of this repo (tzel/)
#
# Builds the Vite + React frontend (web/) and serves it via nginx.
# nginx proxies backend calls (matching vite.config.ts proxy rules):
#   /api/*    → tzel-operator:8787  (prefix stripped)
#   /wallet/* → wallet-server:8081  (prefix stripped)

FROM node:22-alpine AS builder

WORKDIR /app
COPY web/package*.json ./
RUN npm ci

COPY web/ .
RUN npm run build

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist              /usr/share/nginx/html
COPY docker/nginx/dapp.conf                /etc/nginx/conf.d/default.conf

EXPOSE 3000
