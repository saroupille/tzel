# syntax=docker/dockerfile:1
# Build context: root of this repo (tzel/)
#
# Stage 1: compile reprove (apps/prover — its own Cargo workspace)
# Stage 2: compile Cairo executables (cairo/ — Scarb)
# Stage 3: runtime with both outputs
#
# apps/prover pulls git dependencies (stwo, cairo-vm, proving-utils) — needs internet at build time.

FROM rust:1.85-slim AS rust-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tzel
COPY . .

WORKDIR /tzel/apps/prover
RUN cargo build --release --bin reprove

# ── Cairo executables ──────────────────────────────────────────────────────────
FROM starknet/scarb:2.16.1 AS cairo-builder

WORKDIR /cairo
COPY cairo/ .
RUN scarb build

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder  /tzel/apps/prover/target/release/reprove  /usr/local/bin/reprove
COPY --from=cairo-builder /cairo/target/                             /opt/tzel/cairo/target/

ENV REPROVE_CAIRO_DIR=/opt/tzel/cairo/target

EXPOSE 9000
ENTRYPOINT ["reprove"]
